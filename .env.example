# ===== 密钥与连接信息模板 =====
# 复制为 .env 后填入真实值（.env 已被 gitignore，不会提交）
# 可调参数请放 config/settings.yaml，不要写在这里

# ---- DeepSeek LLM ----
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 模型名（默认 deepseek-chat；可在 .env 覆盖 settings.yaml 的 llm.model，env 优先，空值回退 yaml）
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 搜索服务（按选型填写：bing / tavily / bocha） ----
SEARCH_PROVIDER=bing
SEARCH_API_KEY=your_search_api_key

# ---- Milvus 连接（Docker 部署，本机 Attu 同地址连接，见 docs/deploy.md） ----
MILVUS_URI=http://localhost:19530

# ---- Redis（缓存 / 限流；Docker 部署见 docs/deploy.md） ----
REDIS_URL=redis://localhost:6379

# ---- BGE-M3 模型本地缓存路径（首次运行自动下载） ----
EMBED_MODEL_PATH=./models/bge-m3

# ---- 重排模型路径（bge-reranker，随 models/ 分发，见 models/ 目录） ----
RERANKER_MODEL_PATH=./models/bge-reranker-large

# ---- 嵌入设备（项目已定 CPU-only：保持默认 cpu，勿设 cuda） ----
EMBED_DEVICE=cpu

# ---- 问答缓存 collection（question → 摘要 + 来源；scripts/init_milvus.py 创建） ----
MILVUS_QA_COLLECTION=webrag_qa

# ---- 离线知识库 collection（管理后台入库用，独立于问答链路；首次入库时自动创建） ----
MILVUS_OFFLINE_COLLECTION=webrag_offline_kb

# ---- MySQL（管理后台：管理员账号 + 文档记录；Docker 部署时 compose 注入 MYSQL_HOST=mysql） ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=webrag
MYSQL_PASSWORD=webrag123
MYSQL_DATABASE=webrag_admin

# ---- 管理后台 JWT 签名密钥（务必改为随机长串；泄露可伪造管理员 token） ----
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
